{
  "imports": {
    "@ai-sdk/openai": "npm:@ai-sdk/openai@^1.3.23",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.5",
    "@fresh/core": "jsr:@fresh/core@^2.1.2",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.5",
    "@microsoft/fetch-event-source": "npm:@microsoft/fetch-event-source@^2.0.1",
    "@playwright/test": "npm:@playwright/test@^1.53.1",
    "@stagewise/toolbar": "npm:@stagewise/toolbar@^0.4.9",
    "lucide-preact": "npm:lucide-preact@^0.469.0",
    "@tailwindcss/cli": "npm:@tailwindcss/cli@^4.1.7",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.15",
    "ai": "npm:ai@^4.3.19",
    "dotenv": "npm:dotenv@^16.5.0",
    "katex": "npm:katex@^0.16.11",
    "marked": "npm:marked@^15.0.6",
    "tailwindcss": "npm:tailwindcss@^4.1.7",
    "shepherd.js": "npm:shepherd.js@14.5.0",
    "vite": "npm:vite@^7.1.11",
    "qrcode": "npm:qrcode@^1.5.3",
    "zod": "npm:zod@^3.23.8",
    "fresh": "jsr:@fresh/core@^2.1.2",
    "preact": "npm:preact@^10.27.2",
    "@preact/signals": "npm:@preact/signals@^2.3.2"
  },
  "tasks": {
    "test": "deno test -A",
    "test:e2e": "deno run --env-file -A npm:playwright test",
    "test:e2e:ui": "deno run --env-file -A npm:playwright test --ui",
    "dev": "VITE_CJS_IGNORE_WARNING=true vite --force",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "preview": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "styles": "deno run npm:@tailwindcss/cli -i ./static/styles.css -o ./static/output.css --watch --allow-read"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "react": ["./node_modules/@types/preact"],
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "nodeModulesDir": "auto",
  "fresh": { "watchIgnorePaths": ["node_modules/", "static/"] }
}
